        "tasks_status": {
          "name": "tasks_status",
          "value": "\"tasks\".\"status\" in ('backlog', 'working', 'approval', 'done', 'held')"
        },
        "tasks_priority": {
          "name": "tasks_priority",
          "value": "\"tasks\".\"priority\" in ('low', 'normal', 'high')"
        },
        "tasks_worked_for": {
          "name": "tasks_worked_for",
          "value": "\"tasks\".\"worked_for\" >= 0"
        },
        "tasks_working": {
          "name": "tasks_working",
          "value": "\"tasks\".\"status\" <> 'working' or (\"tasks\".\"assignee_id\" is not null and \"tasks\".\"started_at\" is not null)"
        },
        "tasks_running": {
          "name": "tasks_running",
          "value": "\"tasks\".\"running_since\" is null or \"tasks\".\"status\" = 'working'"
        },
        "tasks_held": {
          "name": "tasks_held",
          "value": "\"tasks\".\"status\" <> 'held' or (\"tasks\".\"held_reason\" is not null and \"tasks\".\"held_from\" is not null)"
        },
        "tasks_finished": {
          "name": "tasks_finished",
          "value": "\"tasks\".\"status\" not in ('approval', 'done') or \"tasks\".\"finished_at\" is not null"
        },
        "tasks_applied": {
          "name": "tasks_applied",
          "value": "\"tasks\".\"status\" <> 'done' or \"tasks\".\"applied_at\" is not null"
